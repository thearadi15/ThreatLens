{\n  \"version\": \"1.0\",\n  \"title\": \"ThreatLens MITRE ATT&CK Detection Rules\",\n  \"description\": \"Elasticsearch queries for threat detection based on MITRE ATT&CK framework\",\n  \"rules\": [\n    {\n      \"id\": \"T1098.001\",\n      \"title\": \"Account Creation via System Account\",\n      \"tactic\": \"Initial Access\",\n      \"technique\": \"Default Accounts\",\n      \"query\": \"process.name:useradd OR process.name:adduser\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"medium\",\n      \"description\": \"Detects creation of new user accounts which may indicate account hijacking\"\n    },\n    {\n      \"id\": \"T1110.001\",\n      \"title\": \"Brute Force - Password Guessing\",\n      \"tactic\": \"Credential Access\",\n      \"technique\": \"Brute Force: Password Guessing\",\n      \"query\": \"message:\\\"Failed password\\\" AND process.name:sshd\",\n      \"index\": \"filebeat-*\",\n      \"severity\": \"high\",\n      \"description\": \"Multiple failed SSH login attempts within 5 minutes suggests brute force attack\",\n      \"threshold\": {\n        \"field\": \"source.ip\",\n        \"value\": 5,\n        \"timewindow\": \"5m\"\n      }\n    },\n    {\n      \"id\": \"T1190\",\n      \"title\": \"Exploitation of Remote Service\",\n      \"tactic\": \"Initial Access\",\n      \"technique\": \"Exploit Public-Facing Application\",\n      \"query\": \"http.response.status_code:(400 OR 403 OR 404 OR 500) AND http.request.method:(GET OR POST) AND http.request.path:*\\\\/admin* OR http.request.path:*\\\\/config*\",\n      \"index\": \"filebeat-*\",\n      \"severity\": \"high\",\n      \"description\": \"HTTP requests to sensitive paths with error responses indicate exploitation attempts\"\n    },\n    {\n      \"id\": \"T1505.001\",\n      \"title\": \"Web Service Extensions Modification\",\n      \"tactic\": \"Persistence\",\n      \"technique\": \"Server Software Component: Web Shell\",\n      \"query\": \"file.extension:php OR file.extension:jsp OR file.extension:aspx AND action:created\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"critical\",\n      \"description\": \"New script files created in web directories indicate web shell deployment\"\n    },\n    {\n      \"id\": \"T1003.008\",\n      \"title\": \"Credential Dumping - /etc/shadow Access\",\n      \"tactic\": \"Credential Access\",\n      \"technique\": \"Credential Dumping: /etc/shadow\",\n      \"query\": \"file.path:\\\"/etc/shadow\\\" AND NOT process.name:root\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"critical\",\n      \"description\": \"Non-root process accessing /etc/shadow file - credential theft attempt\"\n    },\n    {\n      \"id\": \"T1134.003\",\n      \"title\": \"Access Token Manipulation\",\n      \"tactic\": \"Defense Evasion\",\n      \"technique\": \"Access Token Manipulation: Token Impersonation/Theft\",\n      \"query\": \"process.name:su OR process.name:sudo OR process.name:pkexec\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"high\",\n      \"description\": \"Privilege escalation attempts via su/sudo/pkexec\"\n    },\n    {\n      \"id\": \"T1543.002\",\n      \"title\": \"Create or Modify System Process - systemd\",\n      \"tactic\": \"Persistence\",\n      \"technique\": \"Create or Modify System Process: Systemd Service\",\n      \"query\": \"file.path:\\\"/etc/systemd/system/*\\\" AND action:created OR action:modified\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"critical\",\n      \"description\": \"Creation/modification of systemd service files for persistence\"\n    },\n    {\n      \"id\": \"T1046\",\n      \"title\": \"Network Service Scanning\",\n      \"tactic\": \"Discovery\",\n      \"technique\": \"Network Service Discovery\",\n      \"query\": \"process.name:nmap OR process.name:netstat OR process.name:ss\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"medium\",\n      \"description\": \"Network reconnaissance tools execution\"\n    },\n    {\n      \"id\": \"T1021.004\",\n      \"title\": \"Remote Services - SSH\",\n      \"tactic\": \"Lateral Movement\",\n      \"technique\": \"Remote Services: SSH\",\n      \"query\": \"process.name:ssh AND source.ip:10.0.2.* AND user.name:labuser\",\n      \"index\": \"filebeat-*\",\n      \"severity\": \"medium\",\n      \"description\": \"SSH lateral movement from attacker VM to victim\"\n    },\n    {\n      \"id\": \"T1071.004\",\n      \"title\": \"Application Layer Protocol - DNS\",\n      \"tactic\": \"Command and Control\",\n      \"technique\": \"Application Layer Protocol: DNS\",\n      \"query\": \"process.name:nslookup OR process.name:dig AND destination.port:53\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"low\",\n      \"description\": \"DNS queries for command and control communication\"\n    },\n    {\n      \"id\": \"T1021.003\",\n      \"title\": \"Remote Services - SSH Reverse Shell\",\n      \"tactic\": \"Command and Control\",\n      \"technique\": \"Remote Access Software\",\n      \"query\": \"process.name:bash AND process.args:*\\\\/dev\\\\/tcp* OR process.name:bash AND process.args:*\\\\/dev\\\\/udp*\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"critical\",\n      \"description\": \"Reverse shell establishment via /dev/tcp or /dev/udp\"\n    },\n    {\n      \"id\": \"T1083\",\n      \"title\": \"File and Directory Discovery\",\n      \"tactic\": \"Discovery\",\n      \"technique\": \"File and Directory Discovery\",\n      \"query\": \"process.name:find OR process.name:ls AND process.args:*-R* OR process.args:*-la*\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"low\",\n      \"description\": \"Recursive file enumeration for discovery\"\n    },\n    {\n      \"id\": \"T1087.001\",\n      \"title\": \"Account Discovery - Local\",\n      \"tactic\": \"Discovery\",\n      \"technique\": \"Account Discovery: Local Account\",\n      \"query\": \"file.path:\\\"/etc/passwd\\\" OR file.path:\\\"/etc/group\\\" AND action:opened\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"medium\",\n      \"description\": \"Reading password/group files for account enumeration\"\n    },\n    {\n      \"id\": \"T1552.007\",\n      \"title\": \"Unsecured Credentials - Hardcoded Credentials\",\n      \"tactic\": \"Credential Access\",\n      \"technique\": \"Unsecured Credentials: Hardcoded Credentials\",\n      \"query\": \"process.name:grep AND process.args:(password OR passwd OR pwd OR secret OR key OR token)\",\n      \"index\": \"auditbeat-*\",\n      \"severity\": \"high\",\n      \"description\": \"Searching for hardcoded credentials in files\"\n    },\n    {\n      \"id\": \"T1566.002\",\n      \"title\": \"Phishing - Spearphishing Link\",\n      \"tactic\": \"Initial Access\",\n      \"technique\": \"Phishing: Spearphishing Link\",\n      \"query\": \"http.request.path:*\\\\/admin* OR http.request.path:*\\\\/login* AND http.response.status_code:200\",\n      \"index\": \"filebeat-*\",\n      \"severity\": \"medium\",\n      \"description\": \"HTTP requests to admin/login pages indicating phishing or exploitation\"\n    }\n  ],\n  \"import_instructions\": {\n    \"format\": \"Elasticsearch Watcher Alerts or Kibana Rules\",\n    \"steps\": [\n      \"1. Open Kibana Management → Stack Management → Rules and Connectors\",\n      \"2. Click 'Create rule'\",\n      \"3. For each rule, enter query in KQL: query field\",\n      \"4. Set threshold and time window based on severity\",\n      \"5. Configure action (email/Slack/PagerDuty) on alert\",\n      \"6. Enable rule\"\n    ],\n    \"example_kql\": \"(message:\\\"Failed password\\\" AND process.name:sshd)\",\n    \"mitre_mapping\": \"All detected techniques are mapped to MITRE ATT&CK for threat correlation\"\n  }\n}\n"